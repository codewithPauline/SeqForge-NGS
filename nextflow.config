manifest {
    name = 'codewithPauline/SeqForge-NGS'
    author = 'Pauline Owusu-Ansah'
    description = 'Reproducible germline variant discovery with transparent QC and validation'
    mainScript = 'main.nf'
    version = '0.1.0-dev'
    nextflowVersion = '!>=24.10.6'
}

params {
    input = null
    fasta = null
    intervals = null
    outdir = 'results'
    help = false
    max_cpus = 8
    index_memory = '64 GB'
    align_memory = '32 GB'
    calling_memory = '8 GB'
    container = 'seqforge-ngs:0.1.0-dev'
    min_qual = 30
    min_depth = 10
}

process {
    shell = ['/bin/bash', '-euo', 'pipefail']
    cpus = 1
    memory = '2 GB'
    time = '4h'
    errorStrategy = 'terminate'
    withLabel: index {
        cpus = { Math.min(4, params.max_cpus as int) }
        memory = { params.index_memory }
        time = '12h'
    }
    withLabel: align {
        cpus = { Math.min(8, params.max_cpus as int) }
        memory = { params.align_memory }
        time = '48h'
    }
    withLabel: calling {
        cpus = { Math.min(4, params.max_cpus as int) }
        memory = { params.calling_memory }
        time = '72h'
    }
}

profiles {
    docker {
        docker.enabled = true
        process.container = params.container
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        process.container = params.container
    }
    slurm {
        process.executor = 'slurm'
    }
    test {
        params.input = "${projectDir}/tests/data/samplesheet.csv"
        params.fasta = "${projectDir}/tests/data/reference.fa"
        params.intervals = "${projectDir}/tests/data/targets.bed"
        params.outdir = 'results-test'
        params.max_cpus = 2
        params.index_memory = '2 GB'
        params.align_memory = '2 GB'
        params.calling_memory = '3 GB'
        process.time = '20m'
    }
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace.tsv"
    overwrite = true
}
dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/dag.html"
    overwrite = true
}
